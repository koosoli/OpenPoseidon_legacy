; OpenPoseidon ICBM: the detonation at [x, y] (icbm_fly.sqs). Particles only: a flash, the fireball,
; the dust ring running out over the ground, then the stem and the mushroom cap rising to ~10 km.
_x = _this select 0
_y = _this select 1
drop ["cl_basic", "", "Billboard", 1, 1.5, [_x, _y, 400], [0, 0, 0], 0, 1.275, 1, 0, [3000, 6000], [[12, 12, 11, 1], [6, 5, 4, 0]], [0], 0, 0, "", "", ""]
_i = 0
#fireball
drop ["cl_fire", "", "Billboard", 1, 16, [_x + (random 600) - 300, _y + (random 600) - 300, 250 + (random 400)], [0, 0, 30 + (random 20)], 2, 1.1, 1, 0.01, [700, 1100, 700], [[8, 7, 5, 1], [5, 2.4, 0.7, 1], [0.6, 0.2, 0.08, 0]], [0, 1], 0.2, 0.2, "", "", ""]
_i = _i + 1
?(_i < 30): goto "fireball"
_i = 0
#ring
_a = _i * 9
drop ["cl_basic", "", "Billboard", 1, 14, [_x + (500 * (cos _a)), _y + (500 * (sin _a)), 40], [320 * (cos _a), 320 * (sin _a), 6], 0, 1.275, 1, 0.02, [300, 700, 900], [[0.7, 0.6, 0.5, 0.8], [0.75, 0.7, 0.65, 0.5], [0.8, 0.8, 0.8, 0]], [0], 0, 0, "", "", ""]
_i = _i + 1
?(_i < 40): goto "ring"
_k = 0
#cloud
; the column rises at ~140 m/s and the cap rides its top, spreading as it climbs (to ~9 km)
_t = _k * 0.06
_top = 300 + (140 * _t)
?(_top > 9000): _top = 9000
_w = 300 + (_top * 0.18)
drop ["cl_basic", "", "Billboard", 1, 45, [_x + (random 500) - 250, _y + (random 500) - 250, 250 + (random (_top * 0.8))], [0, 0, 60 + (random 40)], 1, 1.1, 1, 0.003, [500, 900, 1100], [[0.45, 0.28, 0.18, 0.95], [0.55, 0.48, 0.42, 0.85], [0.65, 0.65, 0.65, 0]], [0], 0.3, 0.3, "", "", ""]
drop ["cl_basic", "", "Billboard", 1, 55, [_x + (random (2 * _w)) - _w, _y + (random (2 * _w)) - _w, _top + (random 600)], [(random 40) - 20, (random 40) - 20, 10], 1, 1.1, 1, 0.003, [900, 1600, 2400], [[0.75, 0.42, 0.25, 0.95], [0.75, 0.66, 0.6, 0.8], [0.75, 0.75, 0.75, 0]], [0], 0.3, 0.3, "", "", ""]
drop ["cl_fire", "", "Billboard", 1, 6, [_x + (random _w) - (_w / 2), _y + (random _w) - (_w / 2), _top - 200 + (random 400)], [0, 0, 20], 1, 1.1, 1, 0.01, [500, 800], [[5, 2.5, 0.8, 0.9], [1, 0.35, 0.1, 0]], [0], 0.2, 0.2, "", "", ""]
~0.06
_k = _k + 1
?(_k < 450): goto "cloud"
