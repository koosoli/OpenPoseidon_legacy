; Everything is mission-local. No weather or user-profile settings are saved.
~1
labFlat = "LabPanelFlat" createVehicle [9510,3510,0]
labNormal = "LabPanelNormal" createVehicle [9515,3510,0]
labGloss = "LabPanelGloss" createVehicle [9520,3510,0]
labLeft = "LabWall" createVehicle [9508,3504,0]
labRight = "LabWall" createVehicle [9522,3504,0]
labRoof = "LabRoof" createVehicle [9515,3504,4.5]
labRoof setPos [9515,3504,4.5]
labFlat setPos [9510,3510,1.5]
labNormal setPos [9515,3510,1.5]
labGloss setPos [9520,3510,1.5]
labLeft setPos [9508,3504,2.25]
labRight setPos [9522,3504,2.25]
labRoomLeft = "LabWall" createVehicle [9540,3504,0]
labRoomRight = "LabWall" createVehicle [9554,3504,0]
labRoomBack = "LabRoomBack" createVehicle [9547,3511,0]
labDoorLeft = "LabDoorSide" createVehicle [9543.15,3497,0]
labDoorRight = "LabDoorSide" createVehicle [9550.85,3497,0]
labRoomRoof = "LabRoof" createVehicle [9547,3504,0]
labRoomLeft setPos [9540,3504,2.25]
labRoomRight setPos [9554,3504,2.25]
labRoomBack setPos [9547,3511,2.25]
labDoorLeft setPos [9543.15,3497,2.25]
labDoorRight setPos [9550.85,3497,2.25]
labRoomRoof setPos [9547,3504,4.5]
; One common elevation: independent ATL placement leaves daylight gaps on slopes.
labRoomBase = ((getPosASL labRoomRoof) select 2) - 4.5
labRoomLeft setPosASL [9540,3504,labRoomBase + 2.25]
labRoomRight setPosASL [9554,3504,labRoomBase + 2.25]
labRoomBack setPosASL [9547,3511,labRoomBase + 2.25]
labDoorLeft setPosASL [9543.15,3497,labRoomBase + 2.25]
labDoorRight setPosASL [9550.85,3497,labRoomBase + 2.25]
labRoomNormal = "LabPanelNormal" createVehicle [9544,3510.6,0]
labRoomGloss = "LabPanelGloss" createVehicle [9550,3510.6,0]
labRoomNormal setPos [9544,3510.6,1.5]
labRoomGloss setPos [9550,3510.6,1.5]
labRoomNormal setPosASL [9544,3510.6,labRoomBase + 1.5]
labRoomGloss setPosASL [9550,3510.6,labRoomBase + 1.5]
; Separate transmissive glass station; GLOSS above is an opaque material test.
labGlass = "LabPanelGlass" createVehicle [9575,3504,0]
labGlass setPos [9575,3504,1.5]
labGlassBase = ((getPosASL labGlass) select 2) - 1.5
labGlassBottom = "LabGlassFrame" createVehicle [9575,3504,0]
labGlassTop = "LabGlassFrame" createVehicle [9575,3504,0]
labGlassLeft = "LabGlassPost" createVehicle [9572.92,3504,0]
labGlassRight = "LabGlassPost" createVehicle [9577.08,3504,0]
labGlassBottom setPosASL [9575,3504,labGlassBase + 0.06]
labGlassTop setPosASL [9575,3504,labGlassBase + 3.06]
labGlassLeft setPosASL [9572.92,3504,labGlassBase + 1.5]
labGlassRight setPosASL [9577.08,3504,labGlassBase + 1.5]
labGlassTarget = "LabPanelNormal" createVehicle [9575,3507,0]
labGlassTarget setPosASL [9575,3507,labGlassBase + 1.5]
labJeep = "Jeep" createVehicle [9480,3525,0]
labTruck = "Ural" createVehicle [9488,3525,0]
labHeli = "UH60" createVehicle [9460,3525,0]
labJeep setDir 180
labTruck setDir 180
labHeli setDir 180
labJeep setPos [9480,3525,0]
labTruck setPos [9488,3525,0]
labHeli setPos [9460,3525,0]
; Sandbox helicopter only: replenish in place, without accumulating magazines.
labHeli addEventHandler ["Fired", {(_this select 0) setVehicleAmmo 1}]
player addMagazine "M16"
player addMagazine "M16"
player addMagazine "M16"
labReset = player addAction ["LAB: reset stacks / dominoes", "action.sqs"]
labCastle = player addAction ["LAB: build large block castle", "action.sqs"]
labRoom = player addAction ["LAB: visit rotating-light room", "action.sqs"]
labRoomLight = player addAction ["LAB: toggle room light", "action.sqs"]
labGlassVisit = player addAction ["LAB: visit GLASS transparency station", "action.sqs"]
labCrater = player addAction ["LAB: experimental terrain crater", "action.sqs"]
labCraterReset = player addAction ["LAB: restore crater terrain", "action.sqs"]
labThrow = player addAction ["LAB: throw selected body", "action.sqs"]
labDrop = player addAction ["LAB: place body at crosshair", "action.sqs"]
labBall = player addAction ["LAB: select ball", "action.sqs"]
labBox = player addAction ["LAB: select box", "action.sqs"]
labLight = player addAction ["LAB: light mode (clears bodies)", "action.sqs"]
labCool = player addAction ["LAB: cool light colour", "action.sqs"]
labClear = player addAction ["LAB: clear bodies", "action.sqs"]
labDay = player addAction ["LAB: day / night", "action.sqs"]
labHelp = player addAction ["LAB: help / station guide", "action.sqs"]
labRideVisit = player addAction ["LAB: visit Jeep passenger firing range", "action.sqs"]
labRideStart = player addAction ["LAB: start / stop Jeep circuit", "action.sqs"]
[] exec "jeep-ride.sqs"
[] exec "heli-ride.sqs"
labFlightVisit = player addAction ["LAB: board helicopter rifle seat", "action.sqs"]
labFlightStart = player addAction ["LAB: start helicopter circuit", "action.sqs"]
labFlightLand = player addAction ["LAB: return and land helicopter", "action.sqs"]
; In cargo, the action menu collects the carrier's actions rather than the player's.
labHeliFlightStart = labHeli addAction ["LAB: start helicopter circuit", "action.sqs"]
labHeliFlightLand = labHeli addAction ["LAB: return and land helicopter", "action.sqs"]
labNight = false
~2
logInfo (triPhysicsShowcase "reset")
hint "SHOWCASE LAB\n\nAhead: stacks and dominoes. Shoot or throw bodies.\nRight: material gallery, left-to-right FLAT / NORMAL / GLOSS.\nBehind: driveable vehicles and helicopter.\n\nUse the LAB action-menu entries. Light mode clears the physics field and allows four lights.\nDev Tools: Physics and Weather for more controls."
logInfo "SHOWCASE: ready"
exit
