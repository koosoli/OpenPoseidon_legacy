_id = _this select 2
? _id == labReset : goto "reset"
? _id == labCastle : goto "castle"
? _id == labRoom : goto "room"
? _id == labRoomLight : goto "roomlight"
? _id == labCrater : goto "crater"
? _id == labCraterReset : goto "craterreset"
? _id == labThrow : goto "throw"
? _id == labDrop : goto "drop"
? _id == labBall : goto "ball"
? _id == labBox : goto "box"
? _id == labLight : goto "light"
? _id == labCool : goto "cool"
? _id == labClear : goto "clear"
? _id == labDay : goto "day"
hint "PHYSICS: shoot the stacks, push the dominoes, or select and throw bodies. Reset rebuilds 42 bodies.\n\nGALLERY: left FLAT, middle ribbed NORMAL, right GLOSS. Same flat geometry and albedo. Enter light mode and throw/place up to four moving lamps. Toggle night for stronger contrast.\n\nVEHICLES: Jeep, Ural, UH60. Weather tab: clouds, wind and experimental snow. Physics tab: body mass, shape, friction and light colour/intensity.\n\nSingle player only. Probe bodies are not saved."
exit
#reset
hint (triPhysicsShowcase "reset")
exit
#castle
hint (triPhysicsShowcase "castle")
player setPos [9500,3530,0]
player setDir 0
hint "BLOCK CASTLE\n32 m wide, 8 m walls and 11 m towers. Lightweight individual blocks. Shoot the walls or throw heavy bodies. Reset restores the small test field."
exit
#room
player setPos [9547,3494,0]
player setDir 0
hint "ROTATING LIGHT ROOM\nEnter through the central doorway. The warm point light moves continuously around the room. NORMAL and GLOSS panels are on the back wall. LAB: toggle room light gives a direct off/on comparison."
exit
#roomlight
hint (triPhysicsShowcase "roomlight")
exit
#crater
hint (triPhysicsShowcase "crater")
player setPos [9700,3430,0]
player setDir 0
hint "EXPERIMENTAL TERRAIN\nCrater ahead at 9700 / 3600. Real heightfield and collision change; coarse source-grid resolution. Walk in or drop a physics body. Restore with LAB: restore crater terrain.\nNot saved, not networked, no tunnels. One rebuild can briefly pause."
exit
#craterreset
hint (triPhysicsShowcase "craterreset")
exit
#throw
hint (triPhysicsShowcase "throw")
exit
#drop
hint (triPhysicsShowcase "drop")
exit
#ball
hint (triPhysicsShowcase "ball")
exit
#box
hint (triPhysicsShowcase "box")
exit
#light
hint (triPhysicsShowcase "light")
exit
#cool
hint (triPhysicsShowcase "cool")
exit
#clear
hint (triPhysicsShowcase "clear")
exit
#day
? labNight : goto "sun"
skipTime (22 - daytime)
labNight = true
exit
#sun
skipTime (17 - daytime)
labNight = false
exit
