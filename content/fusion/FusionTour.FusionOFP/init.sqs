; All destinations belong to the same world, not separate mission loads.
~1
vehicle player addAction ["Visit Everon", "everon.sqs"]
vehicle player addAction ["Visit Malden", "malden.sqs"]
vehicle player addAction ["Visit Kolgujev", "kolgujev.sqs"]
